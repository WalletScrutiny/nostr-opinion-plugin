{
	"name": "nostr-opinion",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "rm -f index.html && ln -s index.staging.html index.html && vite",
		"build": "vite build",
		"build:summariser": "esbuild ./src/summariser.ts --bundle --platform=node --target=node22 --outfile=./dist/nostr-opinion-summariser.js --format=cjs",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepare": "husky install",
		"lint": "eslint src --fix",
		"format": "prettier src --write",
		"deploy:staging": "rm -f .env.local && ln -s .env.staging .env.local && rm -f index.html && ln -s index.staging.html index.html && ./bin/deploy.sh",
		"deploy:production": "rm -f .env.local && ln -s .env.production .env.local && rm -f index.html && ln -s index.production.html index.html && npm run build && cp index.html ./dist && ./bin/deploy.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tsconfig/svelte": "^5.0.8",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.6",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@drenso-toast-ui/editor": "^3.4.1",
		"@nostr-dev-kit/ndk": "2.15.2",
		"@nostr-dev-kit/ndk-cache-dexie": "2.6.44",
		"@nostr-dev-kit/ndk-svelte": "2.4.48",
		"dompurify": "^3.4.14",
		"nostr-tools": "^2.23.8"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": "eslint src --fix",
		"*.{json,js,ts,svelte,html}": "prettier src --write --ignore-unknown"
	}
}
